# Production reverse proxy config, mirrored from the live server
# (/home/ubuntu/bip/Caddyfile). Used by docker-compose.prod.yml's caddy
# service. api.bipterminal.com is DNS-only (grey cloud) in Cloudflare so
# Caddy can complete its own Let's Encrypt HTTP-01 challenge directly
# against this host - a proxied (orange cloud) record would intercept that
# handshake and break automatic HTTPS.
api.bipterminal.com {
	# HSTS - Caddy terminates TLS here, but doesn't add this header on its
	# own; the backend's own security-headers middleware (main.py) covers
	# X-Content-Type-Options/X-Frame-Options/Referrer-Policy instead, since
	# those apply regardless of what's in front of it.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Caddy does NOT compress on its own - without this directive every
	# JSON response left here at full size. The backend now also applies
	# GZipMiddleware (see app/main.py) so responses are compressed even
	# when something other than Caddy is in front; Caddy skips
	# re-compressing anything already encoded, so the two don't conflict.
	# zstd is listed first because browsers that support it decode it
	# faster and smaller than gzip, which stays as the fallback.
	encode zstd gzip

	route {
		handle_path /download/* {
			root * /srv/downloads
			file_server
		}
		reverse_proxy backend:8000
	}
}
