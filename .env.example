# --- BIST Intelligence Platform (BIP) Configuration Template ---

# Application Environment
ENVIRONMENT=development
SECRET_KEY=supersecretjwtkeyforlocaldevelopmentonly12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Configuration
POSTGRES_USER=bip_user
POSTGRES_PASSWORD=bip_password
POSTGRES_DB=bip_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bip_user:bip_password@db:5432/bip_db

# Redis Configuration (Cache & Celery Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# AI / Large Language Model API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Financial Data APIs
FINNHUB_API_KEY=your_finnhub_api_key_here
FMP_API_KEY=your_fmp_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# Macroeconomic Data APIs
EVDS_API_KEY=your_tcmb_evds_api_key_here

# Payment Provider Integration
IYZICO_API_KEY=your_iyzico_api_key_here
IYZICO_SECRET_KEY=your_iyzico_secret_key_here
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com # Sandbox URL for testing
STRIPE_API_KEY=your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Telegram & Discord Notifications (Alert System)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Chat ID to send uptime/crash alerts to (see deploy/uptime_check.sh and
# app/core/notify.py). Get yours by messaging your bot once, then GET
# https://api.telegram.org/bot<token>/getUpdates and reading "chat":{"id":...}
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Public Web App URL (used for links inside emails, and auto-allowed by CORS)
FRONTEND_URL=https://pirazizyatirim.netlify.app
# Additional browser origins allowed to call the API, comma-separated. Needed
# when the site is served from a custom domain (Cloudflare DNS -> Netlify),
# since the built-in CORS pattern only covers *.netlify.app addresses.
# Example: EXTRA_CORS_ORIGINS=https://www.example.com,https://example.com
EXTRA_CORS_ORIGINS=

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
